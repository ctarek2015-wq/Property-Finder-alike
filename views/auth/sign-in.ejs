<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign In</title>
  <link rel="stylesheet" href="/stylesheets/app.css" />
</head>

<body class="page page-auth">
  <%- include('../partials/_navbar') %>
  <h1>Sign in to your account!</h1>
  <form action="/auth/sign-in" method="POST" id="sign-in-form" class="auth-form">
    <div class="form-group">
      <label for="email">Email:</label>
      <input type="email" name="email" id="email" required />
    </div>

    <div class="form-section role-section">
      <h3 class="legend">Role:</h3>

      <div class="radio-group">
        <div class="form-group radio-option">
          <input type="radio" value="seeker" id="seeker" name="role" checked />
          <label for="seeker">seeker</label>
        </div>

        <div class="form-group radio-option">
          <input type="radio" value="owner" id="owner" name="role" />
          <label for="owner">owner</label>
        </div>
      </div>
    </div>

    <div class="form-group">
      <label for="password">Password:</label>
      <input type="password" name="password" id="password" required />
    </div>

    <button type="submit" class="btn btn-submit">Sign in</button>
  </form>
</body>

</html>