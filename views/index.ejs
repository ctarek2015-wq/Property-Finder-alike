<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Home Page</title>
  <link rel="stylesheet" href="/stylesheets/app.css" />

</head>

<body class="page page-home">
  <%- include('./partials/_navbar') %>
  <% if(user){ %>
  <h1>Welcome <%= user.username %></h1>
  <% }else{ %>
  <h1>Welcome to the app!</h1>
  <% } %>

  <details class="home-filter-disclosure">
    <summary>Filter</summary>
    <form class="home-filter-bar" action="/" method="get">
      <div class="filter-field">
        <label for="price-min">Price from</label>
        <input type="number" id="price-min" name="priceMin" min="0" step="any" value="<%= filters.priceMin %>">
      </div>
      <div class="filter-field">
        <label for="price-max">Price to</label>
        <input type="number" id="price-max" name="priceMax" min="0" step="any" value="<%= filters.priceMax %>">
      </div>
      <div class="filter-field">
        <label for="area-min">Area from</label>
        <input type="number" id="area-min" name="areaMin" min="0" step="any" value="<%= filters.areaMin %>">
      </div>
      <div class="filter-field">
        <label for="area-max">Area to</label>
        <input type="number" id="area-max" name="areaMax" min="0" step="any" value="<%= filters.areaMax %>">
      </div>
      <div class="filter-field">
        <label for="bedrooms">Bedrooms (min)</label>
        <input type="number" id="bedrooms" name="bedrooms" min="0" step="1" value="<%= filters.bedrooms %>">
      </div>
      <div class="filter-field">
        <label for="bathrooms">Bathrooms (min)</label>
        <input type="number" id="bathrooms" name="bathrooms" min="0" step="1" value="<%= filters.bathrooms %>">
      </div>
      <div class="filter-field">
        <label for="location">Location</label>
        <select id="location" name="location">
          <option value="">Any location</option>
          <% locations.forEach(option => { %>
          <option value="<%= option %>" <%= filters.location === option ? "selected" : "" %>><%= option %></option>
          <% }) %>
        </select>
      </div>
      <div class="filter-field">
        <label for="rating">Reviews (min)</label>
        <select id="rating" name="rating">
          <option value="">Any rating</option>
          <% [1, 2, 3, 4, 5].forEach(option => { %>
          <option value="<%= option %>" <%= filters.rating === String(option) ? "selected" : "" %>><%= option %> stars</option>
          <% }) %>
        </select>
      </div>
      <div class="filter-field">
        <label for="availability">Availability</label>
        <select id="availability" name="availability">
          <option value="available" <%= filters.availability === "available" ? "selected" : "" %>>Available</option>
          <option value="unavailable" <%= filters.availability === "unavailable" ? "selected" : "" %>>Unavailable</option>
          <option value="all" <%= filters.availability === "all" ? "selected" : "" %>>All listings</option>
        </select>
      </div>
      <div class="filter-actions">
        <button class="btn" type="submit">Apply filters</button>
        <a class="btn btn-secondary" href="/">Clear</a>
      </div>
    </form>
  </details>

  <% if(properties.length === 0){ %>
  <p class="home-no-results">No properties match these filters.</p>
  <% } %>

  <% properties.forEach(prop=> { %>

  <div class="property-listings" id="property-listings">
    <div class="property-card">
      <% const homeMainImage = prop.images && prop.images.length > 0
        ? (prop.images.find(image => image.publicId === prop.mainImagePublicId) || prop.images[0])
        : null; %>
      <% if (homeMainImage) { %>
      <img class="property-card-image" src="<%= homeMainImage.url %>" alt="<%= prop.title %>">
      <% } else { %>
      <div class="property-card-image property-card-image-empty" aria-label="No property image">No image</div>
      <% } %>
      <h3 class="legend"><%= prop.title %></h3>
      <div class="property-details">
        <p class="detail-item"><strong>Owner:</strong> <%= prop.owner.username %></p>
        <p class="detail-item"><strong>Location:</strong> <%= prop.location %></p>
        <p class="detail-item"><strong>Property Type:</strong> <%= prop.listingType %></p>
        <p class="detail-item"><strong>Price:</strong> <%= prop.price %></p>
        <p class="detail-item"><strong>Area:</strong> <%= prop.area %></p>
        <% if(prop.available === true){ %>
        <p class="detail-item"><strong>Available for viewings</strong></p>
        <% }else{ %>
        <p class="detail-item"><strong>Not Available for viewings</strong></p>
        <% } %>
      </div>

      <div class="property-actions">
        <% if(!user){ %>
        <a href="/auth/sign-in"> <button class="btn">Please log in to view properties</button></a>
        <% }else{ %>

        <% if(seekerViewings && seekerViewings.some(viewing => viewing.propertyId.toString() === prop._id.toString() && viewing.status.toString() === 'completed')&& userReviews.some(review=> review.propertyId.toString() === prop._id.toString() && !review.reviewed)){ %>
        <a href="/properties/<%= prop._id %>"><button class="btn">Please Leave a Review</button></a>
        <% }else{ %>
        <a href="/properties/<%= prop._id %>"><button class="btn">View Property</button></a>
        <% } %>

        <% } %>
      </div>

    </div>


    <% }) %>
  </div>

</body>

</html>