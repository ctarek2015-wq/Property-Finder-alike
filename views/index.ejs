<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Home Page</title>
  <link rel="stylesheet" href="/style.css" />

</head>
<%- include('./partials/_navbar') %>

<body>
  <% if(user){ %>
  <h1>Welcome <%= user.username %></h1>
  <% }else{ %>
  <h1>Welcome to the app!</h1>
  <% } %>

  <% properties.forEach(prop=> {if(prop.available === true){ %>

  <fieldset>
    <legend><%= prop.title %></legend>
    <p>Owner: <%= prop.owner.username %></p>
    <p>Description: <%= prop.description %></p>
    <p>Location: <%= prop.location %></p>
    <p>Property Type: <%= prop.listingType %></p>
    <p>Price: <%= prop.price %></p>
    <p>Area: <%= prop.area %></p>
    <p>Bedrooms: <%= prop.bedrooms %></p>
    <p>Bathrooms: <%= prop.bathrooms %></p>

    <% if(!user){ %>
    <a href="/auth/sign-in"> <button>Please log in to view properties</button></a>
    <% }else{ %>
    <% if(prop.available === true){ %>
    <p>Available for viewings</p>
    <% }else{ %>
    <p>Not Available for viewings</p>
    <% } %>
    <% if(prop.availableAppointments){ %>
    <p>From: <%= prop.availableAppointments.dateFrom.toISOString().split('T')[0] %></p>
    <p>To: <%= prop.availableAppointments.dateTo.toISOString().split('T')[0] %></p>
    <p>Time Slots: <%= prop.availableAppointments.time %></p>
    <% } %>
    <a href="/properties/<%= prop._id %>"><button>View Property</button></a>
    <% } %>
  </fieldset>


  <% }}) %>


</body>

</html>