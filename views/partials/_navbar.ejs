<nav class="site-nav" aria-label="Global navigation">
  <div class="nav-inner">
    <a class="nav-brand" href="/">PropertySeeker</a>

    <input class="nav-menu-toggle" type="checkbox" id="nav-menu-toggle" />
    <label class="nav-toggle" for="nav-menu-toggle" aria-label="Toggle navigation menu">
      <span class="icon-open" aria-hidden="true">☰</span>
      <span class="icon-close" aria-hidden="true">×</span>
    </label>

    <div class="nav-links">
      <% if (user) { %>
      <% if (user.role === 'owner') { %>
      <a href="/properties/new">List Property</a>
      <a href="/properties">My Listings</a>
      <a href="/appointments">Appointments</a>
      <% } %>
      <% if (user.role === 'seeker') { %>
      <a href="/appointments">My Viewings</a>
      <% } %>

      <a class="nav-role" href="/profile">
        <% if (user.profileImage && user.profileImage.url) { %>
        <img class="profile-icon" src="<%= user.profileImage.url %>" alt="Profile picture">
        <% } else { %>
        <span class="profile-icon profile-icon-fallback" aria-hidden="true"></span>
        <% } %>
        <%= user.role %>
      </a>
      <a href="/auth/sign-out">Sign Out</a>
      <% } else { %>
      <a href="/auth/sign-up">Sign Up</a>
      <a href="/auth/sign-in">Sign In</a>
      <% } %>
    </div>
  </div>
</nav>