<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <link rel="stylesheet" href="/stylesheets/style.css" />

</head>
<%- include('../../partials/_navbar.ejs') %>

<body>
  <h1>Welcome <%= user.username %></h1>

  <form action="/appointments/<%= viewing._id %>?_method=PUT" method="post" id="appointment-form" class="appointment-form">

    <div class="form-section">
      <h3 class="legend">Edit Appointment:</h3>

      <div class="form-group">
        <label for="appointmentDate">Appointment Date:</label>
        <select name="appointmentDate" id="appointmentDate" required>
          <option value="">--Please choose an option--</option>
          <% availableDates.forEach(date => { %>
          <option value="<%= date %>" <%= viewing.appointmentDate.toISOString().split('T')[0] === date ? 'selected' : '' %>><%= date %></option>
          <% }); %>
        </select>
      </div>

      <div class="form-group">
        <label for="appointmentTime">Appointment Time:</label>
        <select name="appointmentTime" id="appointmentTime" required>
          <option value="">--Please choose an option--</option>
          <% time.forEach(time => { %>
          <option value="<%= time %>" <%= viewing.appointmentTime === time ? 'selected' : '' %>><%= time %></option>
          <% }); %>
        </select>
      </div>
    </div>
    <button type="submit" class="btn btn-submit">Submit Property</button>
  </form>

  <form action="/appointments/<%= viewing._id %>?_method=DELETE" method="post" class="delete-form">
    <button type="submit" class="btn btn-delete">Delete Appointment</button>
  </form>



</body>

</html>