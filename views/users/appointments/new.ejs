<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>New Appointment</title>
  <link rel="stylesheet" href="/stylesheets/app.css" />

</head>

<body class="page page-appointments">
  <%- include('../../partials/_navbar.ejs') %>
  <h1>Welcome <%= user.username %></h1>

  <form action="/appointments?propertyId=<%= prop._id %>" method="post" id="appointment-form" class="appointment-form">

    <div class="form-section">
      <h3 class="legend">New Appointment:</h3>

      <div class="form-group">
        <label for="appointmentDate">Appointment Date:</label>
        <select name="appointmentDate" id="appointmentDate" required>
          <option value="">--Please choose an option--</option>
          <% availableDates.forEach(date => { %>
          <option value="<%= date %>"><%= date %></option>
          <% }); %>
        </select>
      </div>

      <div class="form-group">
        <p class="legend">Appointment Time:</p>
        <div class="time-slot-picker" id="appointmentTime">
          <% time.forEach((slot, idx) => { %>
          <div class="time-slot-option">
            <input type="radio" name="appointmentTime" value="<%= slot %>" id="appointment-time-<%= idx %>" required>
            <label for="appointment-time-<%= idx %>"><%= slot %></label>
          </div>
          <% }); %>
        </div>
      </div>
    </div>
    <button type="submit" class="btn btn-submit">Submit Property</button>
  </form>




</body>

</html>