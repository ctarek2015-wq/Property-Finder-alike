<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Property</title>
  <link rel="stylesheet" href="/stylesheets/app.css" />
  <script defer src="/js/property-image-picker.js"></script>

</head>

<body class="page page-properties">
  <%- include('../../partials/_navbar.ejs') %>
  <%- include('../../partials/_errors.ejs', { errors: errors || [] }) %>
  <h1>Welcome <%= user.username %></h1>

  <form action="/properties/<%= property._id %>?_method=PUT" method="post" enctype="multipart/form-data" id="property-form" class="property-form">

    <div class="form-section property-edit-section">
      <h3 class="legend">Edit Property:</h3>
      <div class="form-subsection property-details-section">
        <h4 class="legend">Property Details:</h4>

        <div class="form-group">
          <label for="title">Property Title:</label>
          <input type="text" name="title" id="title" value="<%= property.title %>" required>
        </div>

        <div class="form-group">
          <label for="description">Description:</label>
          <textarea name="description" id="description"><%= property.description %></textarea>
        </div>

        <div class="form-group">
          <label for="location">Location:</label>
          <select name="location" id="location">
            <option value="">--Please choose an option--</option>
            <% locations.forEach(location => { %>
            <option value="<%= location %>" <%= location === property.location ? 'selected' : '' %>>
              <%= location %>
            </option>
            <% }); %>
          </select>
        </div>

        <div class="form-subsection listing-type-section">
          <h5 class="legend">Property Type:</h5>

          <div class="radio-group">
            <div class="form-group radio-option">
              <input type="radio" name="listingType" id="rent" value="rent" <%= property.listingType === 'rent' ? 'checked' : '' %>>
              <label for="rent">Rent</label>
            </div>
            <div class="form-group radio-option">
              <input type="radio" name="listingType" id="sale" value="sale" <%= property.listingType === 'sale' ? 'checked' : '' %>>
              <label for="sale">Sale</label>
            </div>
          </div>
        </div>

        <div class="form-group">
          <label for="price">Price (BHD):</label>
          <input type="number" name="price" id="price" value="<%= property.price %>" required>
        </div>
      </div>

      <div class="form-subsection property-specs-section">
        <h4 class="legend">Property Specifications:</h4>

        <div class="form-group">
          <label for="area">Area (m²):</label>
          <input type="number" name="area" id="area" value="<%= property.area %>" required>
        </div>

        <div class="form-group">
          <label for="bedrooms">Bedrooms:</label>
          <input type="number" name="bedrooms" id="bedrooms" value="<%= property.bedrooms %>" required>
        </div>

        <div class="form-group">
          <label for="bathrooms">Bathrooms:</label>
          <input type="number" name="bathrooms" id="bathrooms" value="<%= property.bathrooms %>" required>
        </div>
      </div>

      <div class="form-subsection property-images-section">
        <h4 class="legend">Property Images:</h4>

        <div class="form-group">
          <label for="images">Add property images:</label>
          <input type="file" name="images" id="images" accept="image/jpeg,image/png,image/webp" multiple>
          <small class="image-upload-help">Upload up to 10 images total. New images are added to the gallery.</small>
          <div id="image-previews" class="image-preview-gallery" aria-live="polite"></div>
          <% if (property.images && property.images.length > 0) { %>
          <div class="current-image-gallery">
            <% property.images.forEach((image, index) => { %>
            <div class="current-image-item">
              <img src="<%= image.url %>" alt="Current property image <%= index + 1 %>">
              <label>
                <input type="radio" name="mainImagePublicId" value="<%= image.publicId %>" <%= property.mainImagePublicId === image.publicId || (!property.mainImagePublicId && index === 0) ? 'checked' : '' %>>
                Featured image
              </label>
              <label>
                <input type="checkbox" name="removeImages" value="<%= image.publicId %>" id="remove-image-<%= index %>">
                Remove image
              </label>
            </div>
            <% }); %>
          </div>
          <% } %>
        </div>
      </div>

      <div class="form-subsection property-availability-section">
        <h4 class="legend">Property Availability:</h4>

        <div class="radio-group">
          <div class="form-group radio-option">
            <input type="radio" name="available" value="true" id="true" <%= property.available === true ? 'checked' : '' %>>
            <label for="true">Available for viewings</label>
          </div>
          <div class="form-group radio-option">
            <input type="radio" name="available" value="false" id="false" <%= property.available === false ? 'checked' : '' %>>
            <label for="false">Not Available for viewings</label>
          </div>
        </div>

        <div class="form-group">
          <label for="dateFrom">From</label>
          <input type="date" name="dateFrom" id="dateFrom" value="<%= property.availableAppointments.dateFrom.toISOString().split('T')[0] %>" required>
        </div>

        <div class="form-group">
          <label for="dateTo">To</label>
          <input type="date" name="dateTo" id="dateTo" value="<%= property.availableAppointments.dateTo.toISOString().split('T')[0] %>" required>
        </div>

        <div class="form-subsection time-slots-section">
          <h5 class="legend">Time Slots:</h5>
          <div class="checkbox-group time-slot-picker">
            <% timeSlots.forEach(time => { %>
            <div class="checkbox-option time-slot-option">
              <input type="checkbox" name="time" value="<%= time %>" <% if(property.availableAppointments.time.includes(time)) { %>checked<% } %> id="<%= time %>">
              <label for="<%= time %>"><%= time %></label>
            </div>
            <% }); %>
          </div>
        </div>
      </div>
    </div>
    <button type="submit" class="btn btn-submit">Submit Property</button>
  </form>




</body>
<%- include('../../partials/_footer.ejs') %>

</html>