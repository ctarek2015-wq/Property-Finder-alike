<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Properties</title>
  <link rel="stylesheet" href="/stylesheets/app.css" />
</head>

<body class="page page-properties">
  <%- include('../../partials/_navbar.ejs') %>
  <h1>Your Listings</h1>

  <% const owned = properties.filter(prop=>prop.owner._id.toString() === user._id) %>
  <% if(owned.length === 0){ %>
  <p>You have no properties listed.</p>
  <% } %>

  <% owned.forEach(prop=>{ %>

  <div class="properties-list" id="properties-list">
    <div class="property-card">
      <% const cardMainImage = prop.images && prop.images.length > 0
        ? (prop.images.find(image => image.publicId === prop.mainImagePublicId) || prop.images[0])
        : null; %>
      <% if (cardMainImage) { %>
      <img class="property-card-image" src="<%= cardMainImage.url %>" alt="<%= prop.title %>">
      <% } else { %>
      <div class="property-card-image property-card-image-empty" aria-label="No property image">No image</div>
      <% } %>
      <h3 class="legend"><%= prop.title %></h3>
      <div class="property-details">
        <p class="detail-item"><strong>Owner:</strong> <%= prop.owner.username %></p>
        <p class="detail-item"><strong>Description:</strong> <%= prop.description %></p>
        <p class="detail-item"><strong>Location:</strong> <%= prop.location %></p>
        <p class="detail-item"><strong>Property Type:</strong> <%= prop.listingType %></p>
        <p class="detail-item"><strong>Price:</strong> <%= prop.price %></p>
        <p class="detail-item"><strong>Area:</strong> <%= prop.area %></p>
        <p class="detail-item"><strong>Bedrooms:</strong> <%= prop.bedrooms %></p>
        <p class="detail-item"><strong>Bathrooms:</strong> <%= prop.bathrooms %></p>
        <% if(prop.available === true){ %>
        <p class="detail-item"><strong>Available for viewings</strong></p>
        <% }else{ %>
        <p class="detail-item"><strong>Not Available for viewings</strong></p>
        <% } %>
        <% if(prop.availableAppointments){ %>
        <p class="detail-item"><strong>From:</strong> <%= prop.availableAppointments.dateFrom.toISOString().split('T')[0] %></p>
        <p class="detail-item"><strong>To:</strong> <%= prop.availableAppointments.dateTo.toISOString().split('T')[0] %></p>
        <div class="time-slots-block">
          <p class="detail-item"><strong>Time Slots:</strong></p>
          <div class="time-slot-list">
            <% const ownerSlots = Array.isArray(prop.availableAppointments.time) ? prop.availableAppointments.time : [prop.availableAppointments.time]; %>
            <% ownerSlots.forEach(slot => { %>
            <span class="time-slot-chip"><%= slot %></span>
            <% }) %>
          </div>
        </div>
        <% } %>
      </div>
      <div class="property-actions">
        <a href="/properties/<%= prop._id %>"><button class="btn">View Property</button></a>
      </div>
    </div>

    <% }) %>
  </div>

</body>

</html>