<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <link rel="stylesheet" href="/stylesheets/style.css" />
</head>
<%- include('../../partials/_navbar.ejs') %>

<body>
  <h1>Welcome <%= user.username %></h1>

  <a href="/properties/new"><button>Add New Property</button></a>

  <% const owned = properties.filter(prop=>prop.owner._id.toString() === user._id) %>
  <% if(owned.length === 0){ %>
  <p>You have no properties listed.</p>
  <% } %>

  <% owned.forEach(prop=>{ %>

  <div class="properties-list" id="properties-list">
    <div class="property-card">
      <h3 class="legend"><%= prop.title %></h3>
      <div class="property-details">
        <p class="detail-item">Owner: <%= prop.owner.username %></p>
        <p class="detail-item">Description: <%= prop.description %></p>
        <p class="detail-item">Location: <%= prop.location %></p>
        <p class="detail-item">Property Type: <%= prop.listingType %></p>
        <p class="detail-item">Price: <%= prop.price %></p>
        <p class="detail-item">Area: <%= prop.area %></p>
        <p class="detail-item">Bedrooms: <%= prop.bedrooms %></p>
        <p class="detail-item">Bathrooms: <%= prop.bathrooms %></p>
        <% if(prop.available === true){ %>
        <p class="detail-item">Available for viewings</p>
        <% }else{ %>
        <p class="detail-item">Not Available for viewings</p>
        <% } %>
        <% if(prop.availableAppointments){ %>
        <p class="detail-item">From: <%= prop.availableAppointments.dateFrom.toISOString().split('T')[0] %></p>
        <p class="detail-item">To: <%= prop.availableAppointments.dateTo.toISOString().split('T')[0] %></p>
        <p class="detail-item">Time Slots: <%= prop.availableAppointments.time %></p>
        <% } %>
      </div>
      <div class="property-actions">
        <a href="/properties/<%= prop._id %>"><button class="btn">View Property</button></a>
      </div>
    </div>

    <% }) %>
  </div>

</body>

</html>