<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>New Property</title>
  <link rel="stylesheet" href="/stylesheets/app.css" />
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body class="page page-properties">
  <%- include('../../partials/_navbar.ejs') %>

  <%- include('../../partials/_errors.ejs') %>

  <h1>Welcome <%= user.username %></h1>

  <form action="/properties" method="post" enctype="multipart/form-data" id="property-form" class="property-form">

    <div class="form-section property-edit-section">
      <h3 class="legend">New Property:</h3>
      <div class="form-subsection property-details-section">
        <h4 class="legend">Property Details:</h4>

        <div class="form-group">
          <label for="title">Property Title:</label>
          <input type="text" name="title" id="title" value="<%= oldInput.title || '' %>" required>
        </div>

        <div class="form-group">
          <label for="description">Description:</label>
          <textarea name="description" id="description"><%= oldInput.description || '' %></textarea>
        </div>

        <div class="form-group">
          <label for="location">Location:</label>
          <select name="location" id="location">
            <option value="">--Please choose an option--</option>
            <% locations.forEach(location => { %>
            <option value="<%= location %>" <%= oldInput.location === location ? 'selected' : '' %>><%= location %></option>
            <% }); %>
          </select>
        </div>

        <div class="form-subsection listing-type-section">
          <h5 class="legend">Property Type:</h5>

          <div class="radio-group">
            <div class="form-group radio-option">
              <input type="radio" name="listingType" id="rent" value="rent" <%= !oldInput.listingType || oldInput.listingType === 'rent' ? 'checked' : '' %>>
              <label for="rent">Rent</label>
            </div>
            <div class="form-group radio-option">
              <input type="radio" name="listingType" id="sale" value="sale" <%= oldInput.listingType === 'sale' ? 'checked' : '' %>>
              <label for="sale">Sale</label>
            </div>
          </div>
        </div>

        <div class="form-group">
          <label for="price">Price:</label>
          <input type="number" name="price" id="price" value="<%= oldInput.price || '' %>" required>
        </div>
      </div>

      <div class="form-subsection property-specs-section">
        <h4 class="legend">Property Specifications:</h4>

        <div class="form-group">
          <label for="area">Area (in Square Meters):</label>
          <input type="number" name="area" id="area" value="<%= oldInput.area || '' %>" required>
        </div>

        <div class="form-group">
          <label for="bedrooms">Bedrooms:</label>
          <input type="number" name="bedrooms" id="bedrooms" value="<%= oldInput.bedrooms || '' %>" required>
        </div>

        <div class="form-group">
          <label for="bathrooms">Bathrooms:</label>
          <input type="number" name="bathrooms" id="bathrooms" value="<%= oldInput.bathrooms || '' %>" required>
        </div>
      </div>

      <div class="form-subsection property-images-section">
        <h4 class="legend">Property Images:</h4>

        <div class="form-group">
          <label for="images">Property images:</label>
          <input type="file" name="images" id="images" accept="image/jpeg,image/png,image/webp" multiple required>
          <small class="image-upload-help">Upload up to 10 JPG, PNG, or WebP images. Each file must be 5 MB or smaller.</small>
        </div>
      </div>

      <div class="form-subsection property-availability-section">
        <h4 class="legend">Property Availability:</h4>

        <div class="radio-group">
          <div class="form-group radio-option">
            <input type="radio" name="available" value="true" id="true" <%= !oldInput.available || oldInput.available === 'true' ? 'checked' : '' %>>
            <label for="true">Available for viewings</label>
          </div>
          <div class="form-group radio-option">
            <input type="radio" name="available" value="false" id="false" <%= oldInput.available === 'false' ? 'checked' : '' %>>
            <label for="false">Not Available for viewings</label>
          </div>
        </div>

        <div class="form-group">
          <label for="dateFrom">From</label>
          <input type="date" name="dateFrom" id="dateFrom" value="<%= oldInput.dateFrom || '' %>" required>
        </div>

        <div class="form-group">
          <label for="dateTo">To</label>
          <input type="date" name="dateTo" id="dateTo" value="<%= oldInput.dateTo || '' %>" required>
        </div>

        <div class="form-subsection time-slots-section">
          <h5 class="legend">Time Slots:</h5>
          <div class="checkbox-group time-slot-picker">
            <% timeSlots.forEach(time => { %>
            <div class="checkbox-option time-slot-option">
              <input type="checkbox" name="time" value="<%= time %>" <%= oldInput.time && oldInput.time.includes(time) ? 'checked' : '' %> id="<%= time %>">
              <label for="<%= time %>"><%= time %></label>
            </div>
            <% }); %>
          </div>
        </div>
      </div>
    </div>
    <button type="submit" class="btn btn-submit">Submit Property</button>

  </form>


</body>

</html>