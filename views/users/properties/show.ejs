<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<%- include('../../partials/_navbar.ejs') %>

<body>
  <h1><%= property.title %></h1>

  <fieldset>
    <p>Owner: <%= property.owner.username %></p>
    <p>Description: <%= property.description %></p>
    <p>Location: <%= property.location %></p>
    <p>Property Type: <%= property.listingType %></p>
    <p>Price: <%= property.price %></p>
    <p>Area: <%= property.area %></p>
    <p>Bedrooms: <%= property.bedrooms %></p>
    <p>Bathrooms: <%= property.bathrooms %></p>

    <fieldset>
      <legend>Property Images:</legend>
      <img src="<%= property.images %>" alt="">
    </fieldset>

    <% if(property.available === true){ %>
    <p>Available for viewings</p>
    <% }else{ %>
    <p>Not Available for viewings</p>
    <% } %>
    <% if(property.availableAppointments){ %>
    <p>From: <%= property.availableAppointments.dateFrom.toISOString().split('T')[0] %></p>
    <p>To: <%= property.availableAppointments.dateTo.toISOString().split('T')[0] %></p>
    <p>Time Slots: <%= property.availableAppointments.time %></p>
    <% } %>

    <% if(user._id === property.owner._id.toString()){ %>
    <a href="/properties/<%= property._id %>/edit"><button>Edit Property</button></a>
    <form action="/properties/<%= property._id %>?_method=DELETE" method="post"><button>Delete Property</button></form>
    <% } %>

    <%  if(seekerViewings && seekerViewings.some(viewing => viewing.status.toString() === 'confirmed' || viewing.status.toString() === 'pending')){ %>
    <a href="/appointments"><button>You have booked an appointment for this property</button></a>
    <%}else if(user.role === 'seeker'){ %>
    <a href="/appointments/new?propertyId=<%= property._id %>"><button>Book an Appointment</button></a>
    <% } %>
  </fieldset>

  <fieldset>
    <legend>Reviews:</legend>
    <% console.log(propReviews); %>
    <% if(propReviews.length > 0){ %>
    <% propReviews.forEach(review => { %>

    <p>Rating: <%= review.rating %></p>
    <p>Comment: <%= review.comment %></p>

    <% if(review.reviewerId.toString() === user._id.toString()){ %>
    <a href="/reviews/<%= review._id %>/edit"><button>Edit Review</button></a>
    <form action="/reviews/<%= review._id %>?_method=DELETE&propertyId=<%= property._id %>" method="post"><button>Delete Review</button></form>
    <% } %>

    <% }) %>
    <% }else{ %>
    <p>No reviews yet.</p>
    <% } %>
  </fieldset>

  <% if(seekerViewings && seekerViewings.some(viewing => viewing.status.toString() === 'completed') && !propReviews.some(review => review.reviewerId.toString() === user._id.toString())){ %>
  <fieldset>
    <legend>Leave a Review:</legend>
    <form action="/reviews?propertyId=<%= property._id %>" method="post">
      <select name="rating" id="rating" required>
        <option value="">Select Rating</option>
        <option value="1">1</option>
        <option value="2">2</option>
        <option value="3">3</option>
        <option value="4">4</option>
        <option value="5">5</option>
      </select>

      <label for="comment">Comment:</label>
      <textarea id="comment" name="comment" required></textarea>

      <button type="submit">Submit Review</button>
    </form>
  </fieldset>
  <% } %>


</body>

</html>