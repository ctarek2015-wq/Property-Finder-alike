<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<%- include('../../partials/_navbar.ejs') %>

<body>
  <h1><%= property.title %></h1>

  <fieldset>
    <p>Owner: <%= property.owner.username %></p>
    <p>Description: <%= property.description %></p>
    <p>Location: <%= property.location %></p>
    <p>Property Type: <%= property.listingType %></p>
    <p>Price: <%= property.price %></p>
    <p>Area: <%= property.area %></p>
    <p>Bedrooms: <%= property.bedrooms %></p>
    <p>Bathrooms: <%= property.bathrooms %></p>

    <fieldset>
      <legend>Property Images:</legend>
      <img src="<%= property.images %>" alt="">
    </fieldset>

    <% if(property.available === true){ %>
    <p>Available for viewings</p>
    <% }else{ %>
    <p>Not Available for viewings</p>
    <% } %>
    <% if(property.availableAppointments){ %>
    <p>From: <%= property.availableAppointments.dateFrom.toISOString().split('T')[0] %></p>
    <p>To: <%= property.availableAppointments.dateTo.toISOString().split('T')[0] %></p>
    <p>Time Slots: <%= property.availableAppointments.time %></p>
    <% } %>

    <% if(user._id === property.owner._id.toString()){ %>
    <a href="/properties/<%= property._id %>/edit"><button>Edit Property</button></a>
    <form action="/properties/<%= property._id %>?_method=DELETE" method="post"><button>Delete Property</button></form>
    <% } %>


    <% if(seekerViewing && user._id === seekerViewing.viewerId.toString()){ %>
    <a href="/appointments"><button>You have booked an appointment for this property</button></a>
    <% }else if(user.role === 'seeker'){ %>
    <a href="/appointments/new?propertyId=<%= property._id %>"><button>Book an Appointment</button></a>
    <% } %>
  </fieldset>




</body>

</html>