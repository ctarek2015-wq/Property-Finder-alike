<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Property Details</title>
  <link rel="stylesheet" href="/stylesheets/app.css" />
  <link rel="stylesheet" href="/stylesheets/components/image-viewer.css" />
  <script defer src="/js/image-viewer.js"></script>
</head>

<body class="page page-properties">
  <%- include('../../partials/_navbar.ejs') %>
  <h1><%= property.title %></h1>

  <div id="property-info" class="property-info-section">
    <div class="property-details">
      <p class="detail-item"><strong>Owner:</strong> <%= property.owner.username %></p>
      <p class="detail-item"><strong>Description:</strong> <%= property.description %></p>
      <p class="detail-item"><strong>Location:</strong> <%= property.location %></p>
      <p class="detail-item"><strong>Property Type:</strong> <%= property.listingType %></p>
      <p class="detail-item"><strong>Price:</strong> BHD <%= Number(property.price).toLocaleString("en-US") %></p>
      <p class="detail-item"><strong>Area:</strong> <%= property.area %> m²</p>
      <p class="detail-item"><strong>Bedrooms:</strong> <%= property.bedrooms %></p>
      <p class="detail-item"><strong>Bathrooms:</strong> <%= property.bathrooms %></p>
    </div>

    <div class="form-subsection property-images-section">
      <h4 class="legend">Property Images:</h4>
      <% if (property.images && property.images.length > 0) { %>
      <div class="property-image-gallery">
        <% property.images.forEach((image, index) => { %>
        <button class="gallery-thumb-button" type="button" aria-label="Enlarge property image <%= index + 1 %>">
          <img class="property-image gallery-thumb" tabindex="0" src="<%= image.url %>" alt="<%= property.title %>, photo <%= index + 1 %>">
        </button>
        <% }); %>
      </div>
      <div id="image-viewer-modal" class="image-viewer" role="dialog" aria-modal="true" aria-label="Property image viewer" hidden>
        <div class="viewer-backdrop"></div>
        <div class="viewer-container">
          <button class="viewer-close" type="button" aria-label="Close image viewer">&times;</button>
          <button class="viewer-prev" type="button" aria-label="Previous image">&#8249;</button>
          <img class="viewer-image" src="" alt="">
          <button class="viewer-next" type="button" aria-label="Next image">&#8250;</button>
          <p class="viewer-counter" aria-live="polite"></p>
        </div>
      </div>
      <% } else { %>
      <p class="no-property-image">No images available.</p>
      <% } %>
    </div>

    <div class="property-details">
      <% if(property.available === true){ %>
      <p class="detail-item"><strong>Available for viewings</strong></p>
      <% }else{ %>
      <p class="detail-item"><strong>Not Available for viewings</strong></p>
      <% } %>
      <% if(property.availableAppointments){ %>
      <p class="detail-item"><strong>From:</strong> <%= property.availableAppointments.dateFrom.toISOString().split('T')[0] %></p>
      <p class="detail-item"><strong>To:</strong> <%= property.availableAppointments.dateTo.toISOString().split('T')[0] %></p>
      <div class="time-slots-block">
        <p class="detail-item"><strong>Time Slots:</strong></p>
        <div class="time-slot-list">
          <% const detailSlots = Array.isArray(property.availableAppointments.time) ? property.availableAppointments.time : [property.availableAppointments.time]; %>
          <% detailSlots.forEach(slot => { %>
          <span class="time-slot-chip"><%= slot %></span>
          <% }) %>
        </div>
      </div>
      <% } %>
    </div>

    <div class="property-actions">
      <% if(user._id === property.owner._id.toString()){ %>
      <a href="/properties/<%= property._id %>/edit"><button class="btn btn-edit">Edit Property</button></a>
      <form action="/properties/<%= property._id %>?_method=DELETE" method="post" class="delete-form"><button class="btn btn-delete">Delete Property</button></form>
      <% } %>

      <%  /* Prevent duplicate active bookings */ %>
      <%  if(seekerViewings && seekerViewings.some(viewing => viewing.status.toString() === 'confirmed' || viewing.status.toString() === 'pending')){ %>
      <a href="/appointments"><button class="btn">You have booked an appointment for this property</button></a>
      <%}else if(user.role === 'seeker'){ %>
      <a href="/appointments/new?propertyId=<%= property._id %>"><button class="btn">Book an Appointment</button></a>
      <% } %>
    </div>
  </div>

  <div id="reviews-section" class="reviews-section">
    <h3 class="legend">Reviews:</h3>
    <% console.log(propReviews); %>
    <% if(propReviews.length > 0){ %>
    <div class="reviews-list">
      <% propReviews.forEach(review => { %>

      <div class="review-card">
        <p class="detail-item"><strong>Rating:</strong> <%= review.rating %></p>
        <p class="detail-item"><strong>Comment:</strong> <%= review.comment %></p>

        <% if(review.reviewerId.toString() === user._id.toString()){ %>
        <div class="review-actions">
          <a href="/reviews/<%= review._id %>/edit"><button class="btn btn-edit">Edit Review</button></a>
          <form action="/reviews/<%= review._id %>?_method=DELETE&propertyId=<%= property._id %>" method="post" class="delete-form"><button class="btn btn-delete">Delete Review</button></form>
        </div>
        <% } %>
      </div>

      <% }) %>
    </div>
    <% }else{ %>
    <p>No reviews yet.</p>
    <% } %>
  </div>

  <% /* Allow one review per property */ %>
  <% if(seekerViewings && seekerViewings.some(viewing => viewing.status.toString() === 'completed') && !propReviews.some(review => review.reviewerId.toString() === user._id.toString())){ %>
  <div id="leave-review-section" class="review-form-section">
    <h3 class="legend">Leave a Review:</h3>
    <form action="/reviews?propertyId=<%= property._id %>" method="post" class="review-form">
      <div class="form-group">
        <select name="rating" id="rating" required>
          <option value="">Select Rating</option>
          <option value="1">1</option>
          <option value="2">2</option>
          <option value="3">3</option>
          <option value="4">4</option>
          <option value="5">5</option>
        </select>
      </div>

      <div class="form-group">
        <label for="comment">Comment:</label>
        <textarea id="comment" name="comment"></textarea>
      </div>

      <button type="submit" class="btn btn-submit">Submit Review</button>
    </form>
  </div>
  <% } %>


</body>
<%- include('../../partials/_footer.ejs') %>

</html>